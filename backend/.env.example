# ============================================================
# HanaStock v2.1 — Plantilla de entorno (copiar a backend/.env)
# NUNCA subir el .env real al repositorio (ya está en .gitignore).
# ============================================================

# ===== Base de datos MySQL (XAMPP / producción) =====
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=cambia_esta_password
DB_NAME=sistema_inventario

# true  => no intenta MySQL y usa directamente SQLite local (desarrollo).
# false => exige MySQL; si el servidor está caído (OperationalError)
#          registra un WARNING y degrada automáticamente a SQLite.
USE_SQLITE_FALLBACK=true

# ===== Aplicación =====
APP_NAME=HanaFlow — Sistema de Inventario
DEBUG=true
HOST=127.0.0.1
PORT=8000

# ===== Observabilidad / negocio =====
DB_ECHO=false
STOCK_MINIMO=10
VALOR_INVENTARIO_BASE_USD=14400.0

# ===== Seguridad =====
# Clave Fernet para cifrar secretos en reposo. Si se omite, se auto-genera
# y guarda en backend/.hana_secret.key (tampoco debe versionarse).
# SECRET_KEY=

# Token de servicio para la API de respaldos (cabecera X-Admin-Token).
# Vacío = /api/admin/backups/* devuelve 503 (fail-closed).
# Generarlo: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_BACKUP_TOKEN=

# ===== Respaldos automáticos =====
BACKUP_RETENTION_DAYS=7
BACKUP_HOUR=2
BACKUP_MINUTE=0

# ===== Override manual (opcional) =====
# URL completa que anula todas las variables DB_* de arriba.
# DATABASE_URL=mysql+pymysql://usuario:password@localhost:3306/sistema_inventario?charset=utf8mb4
